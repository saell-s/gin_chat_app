# Application
APP_NAME=gin-api
APP_ENV=development
APP_PORT=8080

# Database: leave DATABASE_URL empty to run with the in-memory store.
DB_MODE=memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gin?sslmode=disable
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=true
DB_SEED=true

# Auth
JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=gin-api

# Kafka (disabled by default; set KAFKA_ENABLED=true to publish events)
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_PREFIX=dev

# CORS
CORS_ORIGINS=*
