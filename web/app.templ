package web

// ChatView is the main messaging and calling screen.
templ ChatView() {
	@Page("Gin Chat", chatBody())
}

templ chatBody() {
	<div class="h-screen w-screen flex overflow-hidden bg-white" x-data="chatApp()" x-init="boot()" x-cloak>
		<!-- Sidebar -->
		<aside
			class="w-full md:w-[400px] shrink-0 flex-col border-r border-wa-border bg-white relative"
			:class="activeConversation ? 'hidden md:flex' : 'flex'"
		>
			<header class="h-14 shrink-0 flex items-center justify-between px-4 bg-wa-header border-b border-wa-border">
				<div class="flex items-center gap-3 min-w-0">
					<div class="w-9 h-9 rounded-full flex items-center justify-center text-white text-sm font-semibold" :style="'background-color:' + avatarColor(me ? me.id : 0)" x-text="initials(me ? me.name : '?')"></div>
					<div class="min-w-0">
						<p class="text-sm font-medium truncate" x-text="me ? me.name : ''"></p>
						<p class="text-[11px] text-wa-muted" x-text="wsStatus === 'open' ? 'Connected' : 'Connecting...'"></p>
					</div>
				</div>
				<div class="flex items-center gap-1">
					<button type="button" class="p-2 rounded-full hover:bg-wa-border transition" title="Calls" @click="panel = panel === 'calls' ? 'none' : 'calls'; if (panel === 'calls') loadCalls()">
						<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
					</button>
					<button type="button" class="p-2 rounded-full hover:bg-wa-border transition" title="New chat" @click="panel = panel === 'new' ? 'none' : 'new'">
						<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
					</button>
					<button type="button" class="p-2 rounded-full hover:bg-wa-border transition" title="Sign out" @click="logout()">
						<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M17 7l-1.4 1.4L18.2 11H8v2h10.2l-2.6 2.6L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
					</button>
				</div>
			</header>

			<div class="px-3 py-2 bg-wa-header">
				<div class="flex items-center gap-2 bg-white rounded-lg px-3 py-1.5">
					<svg viewBox="0 0 24 24" class="w-4 h-4 fill-wa-muted shrink-0"><path d="M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z"/></svg>
					<input type="search" x-model="search" placeholder="Search or start a new chat" class="w-full text-sm bg-transparent focus:outline-none py-1"/>
				</div>
			</div>

			<!-- Call history panel -->
			<div x-show="panel === 'calls'" x-transition.opacity class="absolute inset-0 z-20 bg-white flex flex-col" style="display:none">
				<div class="h-14 flex items-center justify-between px-4 border-b border-wa-border">
					<h2 class="font-semibold text-sm">Calls</h2>
					<button type="button" class="p-2 rounded-full hover:bg-wa-border" @click="panel = 'none'">
						<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
					</button>
				</div>
				<ul class="flex-1 overflow-y-auto thin-scroll">
					<li class="flex items-center gap-3 px-4 py-3 border-b border-wa-border/60" x-show="calls.length === 0">
						<span class="text-sm text-wa-muted">No calls yet</span>
					</li>
					<template x-for="c in calls" :key="'call-' + c.id">
						<li class="flex items-center gap-3 px-4 py-3 border-b border-wa-border/60 hover:bg-wa-panel cursor-pointer" @click="redial(c)">
							<div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-semibold shrink-0" :style="'background-color:' + avatarColor(c.peer_id)" x-text="initials(nameOf(c.peer_id))"></div>
							<div class="min-w-0 flex-1">
								<p class="text-sm font-medium truncate" x-text="nameOf(c.peer_id)"></p>
								<p class="text-xs text-wa-muted flex items-center gap-1">
									<span x-text="c.direction === 'outbound' ? (c.status === 'missed' || c.status === 'cancelled' ? 'Outgoing' : 'Outgoing') : (c.status === 'missed' ? 'Missed' : 'Incoming')"></span>
									<span>&middot;</span>
									<span x-text="time(c.created_at)"></span>
									<span x-show="c.duration_seconds > 0" x-text="'&middot; ' + duration(c.duration_seconds)"></span>
								</p>
							</div>
							<svg viewBox="0 0 24 24" class="w-5 h-5 shrink-0" :class="c.status === 'missed' ? 'fill-red-500' : 'fill-wa-teal'"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
						</li>
					</template>
				</ul>
			</div>

			<!-- New chat panel -->
			<div x-show="panel === 'new'" x-transition.opacity class="absolute inset-0 z-20 bg-white flex flex-col" style="display:none">
				<div class="h-14 flex items-center justify-between px-4 border-b border-wa-border">
					<h2 class="font-semibold text-sm">New chat</h2>
					<button type="button" class="p-2 rounded-full hover:bg-wa-border" @click="panel = 'none'">
						<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M19 6.4 17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z"/></svg>
					</button>
				</div>
				<ul class="flex-1 overflow-y-auto thin-scroll">
					<template x-for="u in directory" :key="'u-' + u.id">
						<li class="flex items-center gap-3 px-4 py-3 border-b border-wa-border/60 hover:bg-wa-panel cursor-pointer" @click="startChat(u.id)">
							<div class="relative shrink-0">
								<div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-semibold" :style="'background-color:' + avatarColor(u.id)" x-text="initials(u.name)"></div>
								<span class="absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white" :class="isOnline(u.id) ? 'bg-wa-teal' : 'bg-gray-300'"></span>
							</div>
							<div class="min-w-0">
								<p class="text-sm font-medium truncate" x-text="u.name"></p>
								<p class="text-xs text-wa-muted truncate" x-text="u.email"></p>
							</div>
						</li>
					</template>
					<li class="px-4 py-3 text-sm text-wa-muted" x-show="directory.length === 0">No other users yet</li>
				</ul>
			</div>

			<!-- Conversation list -->
			<ul class="flex-1 overflow-y-auto thin-scroll">
				<template x-for="c in filteredConversations" :key="'c-' + c.id">
					<li
						class="flex items-center gap-3 px-4 py-3 border-b border-wa-border/60 cursor-pointer transition"
						:class="activeId === c.id ? 'bg-wa-panel' : 'hover:bg-wa-panel/60'"
						@click="selectConversation(c.id)"
					>
						<div class="relative shrink-0">
							<div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-semibold" :style="'background-color:' + avatarColor(peerIdOf(c))" x-text="initials(nameOf(peerIdOf(c)))"></div>
							<span class="absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white" :class="isOnline(peerIdOf(c)) ? 'bg-wa-teal' : 'bg-gray-300'"></span>
						</div>
						<div class="min-w-0 flex-1">
							<div class="flex items-baseline justify-between gap-2">
								<p class="text-sm font-medium truncate" x-text="nameOf(peerIdOf(c))"></p>
								<span class="text-[11px] text-wa-muted shrink-0" x-text="c.last_message ? time(c.last_message.created_at) : ''"></span>
							</div>
							<div class="flex items-center justify-between gap-2">
								<p class="text-[13px] text-wa-muted truncate" x-text="preview(c)"></p>
								<span x-show="c.unread > 0" class="shrink-0 min-w-5 h-5 px-1.5 rounded-full bg-wa-teal text-white text-[11px] font-medium flex items-center justify-center" x-text="c.unread > 99 ? '99+' : c.unread"></span>
							</div>
						</div>
					</li>
				</template>
				<li class="px-4 py-6 text-center text-sm text-wa-muted" x-show="filteredConversations.length === 0">
					No chats yet. Start one with the new chat button.
				</li>
			</ul>
		</aside>

		<!-- Conversation -->
		<main
			class="flex-1 min-w-0 flex-col chat-wallpaper relative"
			:class="activeConversation ? 'flex' : 'hidden md:flex'"
		>
			<div x-show="!activeConversation" class="flex-1 flex flex-col items-center justify-center text-center px-6 bg-wa-panel">
				<svg viewBox="0 0 24 24" class="w-28 h-28 fill-wa-muted/40 mb-4"><path d="M12 2C6.5 2 2 6.1 2 11.2c0 2.9 1.5 5.5 3.8 7.2L5 22l4-1.4c.9.3 2 .5 3 .5 5.5 0 10-4.1 10-9.2S17.5 2 12 2zm0 17.2c-1 0-2-.2-2.9-.5l-.7-.3-2.4.8.8-2.3-.4-.7c-1.5-1.5-2.4-3.4-2.4-5.5 0-4.4 4-8 9-8s9 3.6 9 8-4 8.5-9 8.5z"/></svg>
				<h2 class="text-xl font-medium text-wa-muted">Gin Chat</h2>
				<p class="text-sm text-wa-muted/80 mt-2 max-w-sm">Select a conversation to start messaging, or begin a new chat. Audio and video calls use WebRTC.</p>
			</div>

			<div x-show="activeConversation" class="flex-1 flex flex-col min-h-0" style="display:none">
				<header class="h-14 shrink-0 flex items-center gap-3 px-4 bg-wa-header border-b border-wa-border">
					<button type="button" class="md:hidden p-1 -ml-1 rounded-full hover:bg-wa-border" @click="activeId = null">
						<svg viewBox="0 0 24 24" class="w-6 h-6 fill-wa-muted"><path d="M20 11H7.8l5.6-5.6L12 4l-8 8 8 8 1.4-1.4L7.8 13H20v-2z"/></svg>
					</button>
					<div class="relative shrink-0">
						<div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-sm font-semibold" :style="'background-color:' + avatarColor(peerIdOf(activeConversation))" x-text="initials(nameOf(peerIdOf(activeConversation)))"></div>
						<span class="absolute bottom-0 right-0 w-3 h-3 rounded-full border-2 border-white" :class="isOnline(peerIdOf(activeConversation)) ? 'bg-wa-teal' : 'bg-gray-300'"></span>
					</div>
					<div class="min-w-0 flex-1">
						<p class="text-sm font-medium truncate" x-text="nameOf(peerIdOf(activeConversation))"></p>
						<p class="text-xs text-wa-muted truncate" x-text="headerSubtitle()"></p>
					</div>
					<div class="flex items-center gap-1">
						<button type="button" class="p-2 rounded-full hover:bg-wa-border transition" title="Voice call" @click="startCall('audio')" :disabled="call.state !== 'idle'">
							<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
						</button>
						<button type="button" class="p-2 rounded-full hover:bg-wa-border transition" title="Video call" @click="startCall('video')" :disabled="call.state !== 'idle'">
							<svg viewBox="0 0 24 24" class="w-5 h-5 fill-wa-muted"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z"/></svg>
						</button>
					</div>
				</header>

				<section class="flex-1 overflow-y-auto thin-scroll px-4 md:px-10 py-6" x-ref="pane" @click="panel = 'none'">
					<div class="max-w-3xl mx-auto space-y-1">
						<template x-for="(m, i) in messages" :key="'m-' + m.id">
							<div class="flex" :class="m.sender_id === (me ? me.id : -1) ? 'justify-end' : 'justify-start'">
								<div
									class="max-w-[75%] md:max-w-[60%] rounded-lg px-3 py-1.5 shadow-sm text-sm break-words"
									:class="m.sender_id === (me ? me.id : -1) ? 'bg-wa-bubble-out' : 'bg-white'"
								>
									<span x-text="m.body" class="whitespace-pre-wrap"></span>
									<span class="inline-flex items-center gap-1 float-right ml-3 mt-1 translate-y-1">
										<span class="text-[10px] text-wa-muted" x-text="time(m.created_at)"></span>
										<span x-show="m.sender_id === (me ? me.id : -1)" class="tick text-[11px]" :class="receiptClass(m)" x-text="receiptText(m)"></span>
									</span>
								</div>
							</div>
						</template>

						<div x-show="peerTyping" class="flex justify-start">
							<div class="bg-white rounded-lg px-4 py-3 shadow-sm flex items-center gap-1">
								<span class="w-2 h-2 rounded-full bg-wa-muted animate-bounce" style="animation-delay:0ms"></span>
								<span class="w-2 h-2 rounded-full bg-wa-muted animate-bounce" style="animation-delay:150ms"></span>
								<span class="w-2 h-2 rounded-full bg-wa-muted animate-bounce" style="animation-delay:300ms"></span>
							</div>
						</div>

						<div x-show="messages.length === 0" class="text-center py-10">
							<p class="text-xs bg-white/80 text-wa-muted rounded-full px-4 py-2 inline-block">This is the beginning of your conversation with <span x-text="nameOf(peerIdOf(activeConversation))"></span>.</p>
						</div>
					</div>
				</section>

				<footer class="shrink-0 px-4 py-3 bg-wa-header border-t border-wa-border">
					<div class="max-w-3xl mx-auto flex items-end gap-3">
						<textarea
							x-model="draft"
							x-ref="composer"
							rows="1"
							placeholder="Type a message"
							class="flex-1 resize-none rounded-lg bg-white px-4 py-2.5 text-sm max-h-32 thin-scroll focus:outline-none"
							@input="onDraft()"
							@keydown.enter.prevent="send()"
						></textarea>
						<button type="button" class="w-11 h-11 shrink-0 rounded-full bg-wa-teal-dark hover:bg-wa-teal text-white flex items-center justify-center transition disabled:opacity-40" @click="send()" :disabled="!draft.trim()">
							<svg viewBox="0 0 24 24" class="w-5 h-5 fill-current"><path d="M3.4 20.4 21 12 3.4 3.6 3 10l12 2-12 2z"/></svg>
						</button>
					</div>
				</footer>
			</div>

			<!-- Call overlay -->
			<div x-show="call.state !== 'idle'" x-transition.opacity class="absolute inset-0 z-40 bg-[#111b21] flex flex-col" style="display:none">
				<div class="flex-1 relative flex items-center justify-center overflow-hidden">
					<video x-ref="remoteVideo" autoplay playsinline class="absolute inset-0 w-full h-full object-cover" :class="call.kind === 'video' && call.state === 'active' ? '' : 'hidden'"></video>
					<div x-show="call.kind === 'audio' || call.state !== 'active'" class="text-center z-10">
						<div class="w-28 h-28 rounded-full flex items-center justify-center text-white text-4xl font-semibold mx-auto mb-4 ring-4 ring-white/10" :style="'background-color:' + avatarColor(call.peerId)" x-text="initials(nameOf(call.peerId))"></div>
						<h3 class="text-white text-xl font-medium" x-text="nameOf(call.peerId)"></h3>
						<p class="text-white/60 text-sm mt-1" x-text="callStatusText()"></p>
					</div>
					<video x-ref="localVideo" autoplay muted playsinline class="absolute bottom-4 right-4 w-40 h-56 object-cover rounded-xl shadow-lg ring-1 ring-white/20 z-20" :class="call.kind === 'video' && call.state === 'active' ? '' : 'hidden'"></video>
				</div>

				<div class="shrink-0 py-6 flex items-center justify-center gap-5">
					<button type="button" x-show="call.state === 'incoming'" class="w-16 h-16 rounded-full bg-wa-teal hover:brightness-110 text-white flex items-center justify-center transition" title="Accept" @click="acceptCall()">
						<svg viewBox="0 0 24 24" class="w-7 h-7 fill-current"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
					</button>
					<button type="button" x-show="call.state === 'incoming'" class="w-16 h-16 rounded-full bg-red-600 hover:bg-red-700 text-white flex items-center justify-center transition rotate-[135deg]" title="Decline" @click="declineCall()">
						<svg viewBox="0 0 24 24" class="w-7 h-7 fill-current"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.3 0 .7-.2 1l-2.3 2.1z"/></svg>
					</button>

					<button type="button" x-show="call.state === 'active'" class="w-14 h-14 rounded-full flex items-center justify-center transition" :class="call.muted ? 'bg-white/25 text-white' : 'bg-white/10 text-white hover:bg-white/20'" title="Toggle microphone" @click="toggleMute()">
						<svg x-show="!call.muted" viewBox="0 0 24 24" class="w-6 h-6 fill-current"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11h-2z"/></svg>
						<svg x-show="call.muted" viewBox="0 0 24 24" class="w-6 h-6 fill-current"><path d="M19 11h-2a5 5 0 0 1-.7 2.6l1.5 1.5A7 7 0 0 0 19 11zM4.3 3 3 4.3l6 6V11a3 3 0 0 0 4.2 2.8l1.5 1.5A5 5 0 0 1 7 11H5a7 7 0 0 0 6 6.9V21h2v-3.1a6.9 6.9 0 0 0 2-.6l3.7 3.7 1.3-1.3L4.3 3zM15 11V5a3 3 0 0 0-5.8-1.1L15 8.2v2.8z"/></svg>
					</button>
					<button type="button" x-show="call.state === 'active' && call.kind === 'video'" class="w-14 h-14 rounded-full flex items-center justify-center transition" :class="call.camOff ? 'bg-white/25 text-white' : 'bg-white/10 text-white hover:bg-white/20'" title="Toggle camera" @click="toggleCam()">
						<svg x-show="!call.camOff" viewBox="0 0 24 24" class="w-6 h-6 fill-current"><path d="M17 10.5V7a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3.5l4 4v-11l-4 4z"/></svg>
						<svg x-show="call.camOff" viewBox="0 0 24 24" class="w-6 h-6 fill-current"><path d="M21 6.5v11l-4-4v2.5H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h13v1.8L21 6.5zM3.3 4 2 5.3l4 4V7H4L21 7l1.7-1.7L22.7 4 3.3 4z"/></svg>
					</button>
					<button type="button" x-show="call.state !== 'incoming'" class="w-16 h-16 rounded-full bg-red-600 hover:bg-red-700 text-white flex items-center justify-center transition" title="End call" @click="hangup()">
						<svg viewBox="0 0 24 24" class="w-7 h-7 fill-current"><path d="M12 9c-1.6 0-3.2.3-4.6.8v3c0 .4-.2.8-.6.9-.9.4-1.8.9-2.6 1.5-.2.2-.4.3-.7.3-.3 0-.5-.1-.7-.3l-2.2-2.2C.5 12.3.5 12 .5 11.7c0-.3.1-.5.3-.7C4.4 8.1 8.1 6.5 12 6.5s7.6 1.6 11.2 4.5c.2.2.3.4.3.7 0 .3 0 .6-.2.8L21 14.7c-.2.2-.4.3-.7.3-.3 0-.5-.1-.7-.3-.8-.6-1.7-1.1-2.6-1.5-.4-.1-.6-.5-.6-.9v-3C15.2 9.3 13.6 9 12 9z" transform="rotate(135 12 12)"/></svg>
					</button>
				</div>
			</div>
		</main>
	</div>
}
